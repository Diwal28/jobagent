# ============================================================
# JobAgent — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS COMMITTER .env
# ============================================================

# --- Supabase (backend) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY= # JAMAIS utilisé côté frontend ni committé

# --- France Travail API ---
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# --- Backend ---
FRONTEND_URL=http://localhost:5173

# --- Frontend (préfixe VITE_ obligatoire) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000/api

# --- Vercel (CI/CD — à mettre dans GitHub Secrets, pas ici) ---
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
